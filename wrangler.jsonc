{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluprint-golf",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/_blob/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "bluprint-golf", "database_id": "32f3eff9-9354-4b27-92d7-5b27775719f0" }
  ],
  "vars": {
    "MAIL_FROM": "BluPrint Golf <login@bluprintgolf.com>",
    "AI_DAILY_LIMIT": "60",
    "MODEL_DEFAULT": "claude-sonnet-5-5",
    "MODEL_QUICK": "claude-haiku-5-5"
  },
  "observability": { "enabled": true }
}
